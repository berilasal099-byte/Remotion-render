node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

build
# render artifacts & runtime knobs (never track)
out_*_chunks/
render.concurrency
auto-chain.*
overnight.*
# derived render assets — regenerated on the runner from the raw audio, so they
# never need to live in git (keeps the repo small between renders)
*.mastered.m4a
# logs / crash dumps
*.log
*.err.log
*.stackdump
# committed-by-accident Python virtualenv (was bloating origin with ~1000 files)
venv/
.venv/

# multi-worker render pool — HOLDS GITHUB PATs, never commit (would leak to worker repos on push)
render-accounts.json
render-worker-*.json
.render-github-state.json
.render-github-split*.json

# transient scratch / test files
test_*.js
test_*.py
*-FINAL.mp4
tmp/
scene-prompts.*
render-props.json
